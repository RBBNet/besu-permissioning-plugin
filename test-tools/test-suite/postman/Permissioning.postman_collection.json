                {
                    "name": "CV-03: Verificar Admin Proxy (bytecode + allowlist)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"CV-03: Admin contract is deployed\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.result) {",
                                    "        var len = (jsonData.result.length - 2) / 2;",
                                    "        console.log(\"Admin bytecode:\", len, \"bytes\");",
                                    "        pm.expect(len).to.be.above(1000);",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
