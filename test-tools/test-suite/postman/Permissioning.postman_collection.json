			"name": "💥 4. Chaos & Fail-Close (FC)",
			"description": "Resilience tests: fail-close behavior when Ingress is missing or invalid.\n\n⚠ These tests require specific test scenarios: scenario-full-network.json:\n   - FC-01: scenario-failclose-no-ingress.json\n   - FC-02: scenario-failclose-invalid-ingress.json",
			"item": [
				{
					"name": "FC-01: Transação com Ingress Ausente (Fail-Close)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"FC-01: Transação BLOQUEADA (sem Ingress)\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.error) {",
									"        console.log(\"✅ FC-01: Fail-close ativado:\", jsonData.error.message);",
									"        pm.expect(jsonData.error.code).to.be.oneOf([-32007, -32000, -32603]);",
									"        pm.expect(true).to.be.true;",
									"    } else if (jsonData.result) {",
									"        console.log(\"❌ FC-01 FAILED: Transaction accepted without Ingress!\");",
									"        pm.expect.fail(\"FC-01: Fail-close DID NOT work. Transaction accepted without Ingress.\");",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
