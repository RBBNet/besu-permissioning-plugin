{
    "info": {
        "_postman_id": "c1f8a8b8-07f9-4d64-8848-005d4df4b256",
        "name": "Plugin Permissioning Suite v2",
        "description": "On-chain permissioning test suite for Hyperledger Besu On-Chain Permissioning Plugin.\n\n Compatible with Besu 25.12.0+ and 26.x.\n\n PREREQUISITES:\n1. Start network: python3 orchestrator.py -c configs/scenario-full-network.json -a start --timeout 180\n2. Generate transactions: python3 postman/gen-signed-tx.py && python3 postman/gen-signed-tx.py --account unauth\n3. Copy hex to ADMIN_SIGNED_TX e UNAUTH_SIGNED_TX\n\n Read postman/README.md for full instructions.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": " 0. Setup & Diagnostics",
            "description": "Diagnostic requests to verify RPC connectivity and retrieve network state. Run these first.",
            "item": [
                {
                    "name": "0.1 eth_chainId — Verify Chain ID",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// Test: chainId must be 0xb8efce (12120014)",
                                    "pm.test(\"Chain ID is 12120014\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.result).to.eql(\"0xb8efce\");",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_chainId\",\n  \"params\": [],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Retrieves network chainId. Must return 0xb8efce (12120014).\n\n Used by gen-signed-tx.py to sign EIP-155 transactions."
                    },
                    "response": []
                },
                {
                    "name": "0.2 eth_blockNumber — Current Block Number",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Current block is hexadecimal\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    pm.expect(jsonData.result).to.match(/^0x[0-9a-fA-F]+$/);",
                                    "    var bloco = parseInt(jsonData.result, 16);",
                                    "    console.log(\"Bloco atual:\", bloco);",
                                    "    pm.expect(bloco).to.be.above(0);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_blockNumber\",\n  \"params\": [],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Ensures basic connectivity with Besu node and returns current block number in hex.\n\n If returning 0x60+, network is producing blocks normally."
                    },
                    "response": []
                },
                {
                    "name": "0.3 eth_gasPrice — Gas Price",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Gas price is valid\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    var gas = parseInt(jsonData.result, 16);",
                                    "    console.log(\"Gas price:\", gas, \"wei =\", gas / 1e9, \"gwei\");",
                                    "    pm.expect(gas).to.be.at.least(0);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_gasPrice\",\n  \"params\": [],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Gets current gas price on network. Useful to determine gas price when generating signed transactions."
                    },
                    "response": []
                },
                {
                    "name": "0.4 eth_getTransactionCount (ADMIN) — Current Nonce",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Nonce da conta ADMIN\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    var nonce = parseInt(jsonData.result, 16);",
                                    "    console.log(\"Nonce ADMIN ({{ADMIN_ADDR}}):\", nonce);",
                                    "    console.log(\"Use: python3 gen-signed-tx.py --nonce\", nonce);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_getTransactionCount\",\n  \"params\": [\"{{ADMIN_ADDR}}\", \"pending\"],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Retrieves current nonce for ADMIN account (0xf39Fd6e5...).\n\n Use this value when generating signed transaction:\n   python3 gen-signed-tx.py --nonce <VALOR>"
                    },
                    "response": []
                },
                {
                    "name": "0.5 eth_getTransactionCount (UNAUTH) — Current Nonce",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"Nonce da conta UNAUTH\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    var nonce = parseInt(jsonData.result, 16);",
                                    "    console.log(\"Nonce UNAUTH ({{UNAUTH_ADDR}}):\", nonce);",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_getTransactionCount\",\n  \"params\": [\"{{UNAUTH_ADDR}}\", \"pending\"],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Gets current nonce for UNAUTH account (0x70997970...).\n\n This account is NOT in allowlist — transactions from it should be rejected in PF-02."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": " 1. Account Permissioning (PF)",
            "description": "Account permissioning tests.\n\n BEFORE RUNNING:\n1. Run: python3 postman/gen-signed-tx.py\n2. Copy hex into ADMIN_SIGNED_TX variable\n3. Run: python3 postman/gen-signed-tx.py --account unauth\n4. Copy hex into UNAUTH_SIGNED_TX variable",
            "item": [
                {
                    "name": "PF-01: eth_sendRawTransaction (Conta Permitida)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// PF-01: Transaction from ADMIN account (permitted) must be ACCEPTED",
                                    "pm.test(\"PF-01: Transaction accepted (tx hash returned)\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    // Success = has 'result' (hash) and NO 'error'",
                                    "    if (jsonData.result && !jsonData.error) {",
                                    "        console.log(\" PF-01 PASSOU: tx hash =\", jsonData.result);",
                                    "        pm.expect(jsonData.result).to.match(/^0x[0-9a-fA-F]{64}$/);",
                                    "    } else if (jsonData.error) {",
                                    "        console.log(\" PF-01 FALHOU:\", JSON.stringify(jsonData.error));",
                                    "        if (jsonData.error.code === -32602) {",
                                    "            console.log(\"    Invalid params = malformed transaction. Re-run gen-signed-tx.py.\");",
                                    "            console.log(\"    Verifique o nonce (request 0.4) e chain ID (request 0.1).\");",
                                    "        }",
                                    "        pm.expect.fail(\"PF-01 should accept transaction: \" + jsonData.error.message);",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_sendRawTransaction\",\n  \"params\": [\"{{ADMIN_SIGNED_TX}}\"],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Sends transaction signed by ADMIN account (on allowlist).\n\n EXPECTED: Returns transaction hash 0x...\n IF FAILS WITH -32602: Invalid transaction format. Re-run gen-signed-tx.py with correct nonce (ver request 0.4).\n\n Variable {{ADMIN_SIGNED_TX}} must contain hex generated by:\n   python3 postman/gen-signed-tx.py"
                    },
                    "response": []
                },
                {
                    "name": "PF-02: eth_sendRawTransaction (Conta Bloqueada)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "// PF-02: Transaction from UNAUTH account (blocked) must be REJECTED",
                                    "pm.test(\"PF-02: Transaction rejected (sender not authorized)\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.error) {",
                                    "        var code = jsonData.error.code;",
                                    "        var msg = jsonData.error.message.toLowerCase();",
                                    "        console.log(\"Erro recebido: code=\" + code + \" msg=\" + msg);",
                                    "        // Plugin rejects with -32007 (or -32000 in some scenarios)",
                                    "        if (code === -32007 || msg.includes(\"not authorized\") || msg.includes(\"permission\")) {",
                                    "            console.log(\" PF-02 PASSED: Account blocked correctly.\");",
                                    "            pm.expect(true).to.be.true;",
                                    "        } else if (code === -32602) {",
                                    "            console.log(\" Invalid params = malformed transaction, NOT permissioning error.\");",
                                    "            console.log(\"   Rode gen-signed-tx.py --account unauth novamente.\");",
                                    "            pm.expect.fail(\"PF-02: Erro errado. Esperado -32007, recebido -32602 (tx mal formada)\");",
                                    "        } else {",
                                    "            console.log(\" Erro inesperado:\", code, msg);",
                                    "            pm.expect.fail(\"PF-02: Erro inesperado: \" + code + \" - \" + msg);",
                                    "        }",
                                    "    } else if (jsonData.result) {",
                                    "        console.log(\" PF-02 FAILED: Blocked account transaction was accepted!\");",
                                    "        console.log(\"   Hash:\", jsonData.result);",
                                    "        console.log(\"   Plugin may not be working correctly.\");",
                                    "        pm.expect.fail(\"PF-02: Blocked account transaction succeeded! Plugin not enforcing permissioning.\");",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_sendRawTransaction\",\n  \"params\": [\"{{UNAUTH_SIGNED_TX}}\"],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Sends transaction signed by UNAUTH account (NOT on allowlist).\n\n EXPECTED: Error code -32007 or unauthorized error response.\n\n Variable {{UNAUTH_SIGNED_TX}} must contain hex generated by:\n   python3 postman/gen-signed-tx.py --account unauth"
                    },
                    "response": []
                },
                {
                    "name": "PF-03: Admin.isAdmin(ADMIN) — Verify if ADMIN is admin",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"PF-03: ADMIN is administrator\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.result) {",
                                    "        var isAdmin = parseInt(jsonData.result, 16);",
                                    "        console.log(\"isAdmin(ADMIN) =\", isAdmin ? \" YES\" : \" NO\");",
                                    "        pm.expect(isAdmin).to.equal(1, \"ADMIN deveria ser administrador\");",
                                    "    } else if (jsonData.error) {",
                                    "        console.log(\"Erro:\", JSON.stringify(jsonData.error));",
                                    "        pm.expect.fail(\"Falha ao consultar Admin: \" + jsonData.error.message);",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{ADMIN_PROXY}}\",\n      \"data\": \"0xfe9fbb80000000000000000000000000f39fd6e51aad88f6f4ce6ab8827279cfffb92266\"\n    },\n    \"latest\"\n  ],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Verifies if ADMIN account is registered as admin in Admin contract (0x181a92c9...).\n\n Function: isAdmin(address)\n Selector: 0xfe9fbb80\n\n EXPECTED: Returns 0x0000...0001 (true = is admin).\n\n NOTE: AccountRules.accountPermitted() has access control and can only be called by plugin via Ingress. Use Admin contract for direct checks."
                    },
                    "response": []
                },
                {
                    "name": "PF-04: Admin.isAdmin(UNAUTH) — Verify if UNAUTH is admin",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"PF-04: UNAUTH is NOT administrator\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.result) {",
                                    "        var isAdmin = parseInt(jsonData.result, 16);",
                                    "        console.log(\"isAdmin(UNAUTH) =\", isAdmin ? \"YES\" : \" NO\");",
                                    "        pm.expect(isAdmin).to.equal(0, \"UNAUTH should NOT be administrator\");",
                                    "    } else if (jsonData.error) {",
                                    "        console.log(\"Erro:\", JSON.stringify(jsonData.error));",
                                    "        pm.expect.fail(\"Falha ao consultar Admin: \" + jsonData.error.message);",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{ADMIN_PROXY}}\",\n      \"data\": \"0xfe9fbb8000000000000000000000000070997970c51812dc3a010c7d01b50e0d17dc79c8\"\n    },\n    \"latest\"\n  ],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Verifies if UNAUTH account is registered as admin.\n\n EXPECTED: Returns 0x0000...0000 (false = NOT admin).\n\nConfirms that only ADMIN has administrative privileges."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": " 2. Node Permissioning (NR)",
            "description": "Node permissioning tests. Verifies if NodeRules is operational.",
            "item": [
                {
                    "name": "NR-01: eth_call nodePermitted (consulta)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"NR-01: NodeRules responde à consulta\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.result) {",
                                    "        console.log(\"Resposta NodeRules:\", jsonData.result);",
                                    "        pm.expect(jsonData.result).to.not.equal(\"0x\");",
                                    "    } else if (jsonData.error) {",
                                    "        console.log(\" NodeRules may not be responding:\", JSON.stringify(jsonData.error));",
                                    "        pm.expect.fail(\"Falha: \" + jsonData.error.message);",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_call\",\n  \"params\": [\n    {\n      \"to\": \"{{NODE_RULES}}\",\n      \"data\": \"0xfe9fbb80000000000000000000000000f39fd6e51aad88f6f4ce6ab8827279cfffb92266\"\n    },\n    \"latest\"\n  ],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Queries NodeRules contract (0xf01d20a2...) to verify if a node address is permitted.\n\n Function: nodePermitted(address)\n Selector: 0xfe9fbb80\n\n EXPECTED: Returns 0x0000...0001 if address is registered as permitted node."
                    },
                    "response": []
                }
            ]
        },
        {
            "name": " 3. Contract Verification (CV)",
            "description": "On-chain checks for pre-deployed genesis contracts: bytecodes, Ingress registrations, and allowlists.",
            "item": [
                {
                    "name": "CV-01: Verificar Account Ingress (bytecode)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "pm.test(\"CV-01: Account Ingress tem bytecode\", function () {",
                                    "    pm.response.to.have.status(200);",
                                    "    var jsonData = pm.response.json();",
                                    "    if (jsonData.result) {",
                                    "        var len = (jsonData.result.length - 2) / 2;",
                                    "        console.log(\"Account Ingress bytecode:\", len, \"bytes\");",
                                    "        pm.expect(len).to.be.above(1000, \"Bytecode muito curto, pode ser EOA\");",
                                    "    }",
                                    "});"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"method\": \"eth_getCode\",\n  \"params\": [\"{{ACCOUNT_INGRESS}}\", \"latest\"],\n  \"id\": 1\n}"
                        },
                        "url": {
                            "raw": "{{RPC_URL}}",
                            "host": [
                                "{{RPC_URL}}"
                            ]
                        },
                        "description": "Verifies if Account Ingress (0x0000...8888) is deployed with bytecode.\n\n EXPECTED: Returns bytecode > 1000 bytes."
                    },
                    "response": []
